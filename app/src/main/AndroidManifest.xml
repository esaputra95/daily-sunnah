<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:allowBackup="false"
        android:label="Daily Sunnah"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".kajian.ui.KajianPlayerActivity"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:exported="false" />
        <activity
            android:name=".kajian.ui.ShortsFeedActivity"
            android:exported="false" />
        <receiver
            android:name=".quran.data.ReadingGoalReminderReceiver"
            android:enabled="true"
            android:exported="false" />
        <receiver
            android:name=".home.DailySunnahWidgetProvider"
            android:exported="true"
            android:label="Daily Sunnah">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/daily_sunnah_widget_info" />
        </receiver>
        <receiver
            android:name=".ibadah.data.PrayerReminderReceiver"
            android:enabled="true"
            android:exported="false" />
        <receiver
            android:name=".ibadah.data.SunnahFastingReminderReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="id.kasirq.dailysunnah.SUNNAH_FASTING_REMINDER" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".ibadah.data.SunnahFastingReminderBootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".ibadah.data.RamadanReminderScheduler$RamadanReminderReceiver"
            android:enabled="true"
            android:exported="false" />
        <receiver
            android:name=".ibadah.data.RamadanReminderScheduler$RamadanReminderBootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name=".quran.data.ReadingGoalBootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

